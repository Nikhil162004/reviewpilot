# Copy to .env locally. Never commit a real .env (it is gitignored).

# Optional: polishes review summaries server-side when set
GROQ_API_KEY=
# Secret for signing/verification and webhook HMAC checks
APP_SECRET=
[SECURITY_DATA]
# Set to "true" only for local API docs (/docs). Keep off in production.
APP_DEBUG=
# Note: user LLM keys and GitHub tokens are NEVER configured here -
# they are sent per-request from the browser and not stored server-side.
